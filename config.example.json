{
  "source": {
    "path": "tests/fixtures/voai-smoke.txt",
    "format": "text",
    "section": {"type": "all"},
    "include_code": false
  },
  "provider": {
    "name": "voai_dialogue",
    "base_url": "https://connect.voai.ai",
    "endpoint": "/TTS/generate-dialogue",
    "credential_env": "VOAI_API_KEY",
    "timeout_seconds": 180,
    "options": {}
  },
  "synthesis": {
    "model": "Sota+",
    "voices": [{"name": "佑希", "style": "聊天"}],
    "speed": 1.0,
    "sample_rate": 24000,
    "format": "mp3",
    "audio_config": {"pitch_shift": 0, "breath_pause": 0}
  },
  "segmentation": {
    "min_characters": 80,
    "target_characters": 160,
    "max_characters": 240
  },
  "output": {
    "directory": "generated-audio",
    "mode": "segments",
    "minimum_bytes": 128
  }
}
